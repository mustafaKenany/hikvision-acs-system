# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=hikvision_acs_dev
DB_NAME_TEST=hikvision_acs_test

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT Configuration
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing
BCRYPT_ROUNDS=10

# Session Secret
SESSION_SECRET=change-this-to-a-random-session-secret

# ===========================================
# HIKVISION DEVICE CONFIGURATION
# ===========================================
# Default HikVision ISAPI Credentials
HIKVISION_DEFAULT_USERNAME=admin
HIKVISION_DEFAULT_PASSWORD=Admin@123

# Device Connection Settings
DEVICE_CONNECTION_TIMEOUT=30000
DEVICE_MAX_RETRIES=3

# Mock Device Service (للتطوير بدون جهاز حقيقي)
USE_MOCK_DEVICE=true

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
UPLOAD_PATH=./uploads
UPLOAD_FACE_PATH=./uploads/faces
UPLOAD_TEMP_PATH=./uploads/temp
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@hikvision-acs.com

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
